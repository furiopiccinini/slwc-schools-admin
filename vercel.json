{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "npm install",
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/db-keepalive",
      "schedule": "0 5,6,11,12 * * *"
    },
    {
      "path": "/api/cron/db-keepalive",
      "schedule": "30 19,20 * * *"
    }
  ]
}
