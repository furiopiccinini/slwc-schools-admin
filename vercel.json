{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "npm install",
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/db-keepalive",
      "schedule": "0 0 * * 0"
    },
    {
      "path": "/api/cron/db-keepalive",
      "schedule": "0 1 * * 0"
    }
  ]
}
